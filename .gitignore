.gradle-fix5b/
.gradle-neoforge/
.gradle-client/
.gradle-client2/
.gradle-mp/
.gradle-lev/
.gradle-neo/
.gradle-arb/
# private Gradle home of the golemfix lane (its own Loom cache).
.gradle-gfix/
# private Gradle home of the w4fix5 lane (its own Loom cache).
.gradle-fix5/
.gradle-fix3/
