  "authors": [
    "Vazkii",
    "pixlepix",
    "nekosune",
    "GTNewHorizons contributors",
    "Thaumcraft 4 Reload contributors (1.21.1 port)"
  ],
  "contributors": [
    "Azanor (Thaumcraft 4)"
  ],
  "contact": {
    "homepage": "https://github.com/acak1221/Thaumic-Tinkerer-1.21.1",
    "sources": "https://github.com/acak1221/Thaumic-Tinkerer-1.21.1",
    "issues": "https://github.com/acak1221/Thaumic-Tinkerer-1.21.1/issues"
  },
  "license": "CC-BY-NC-SA-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "thaumic.tinkerer.fabric.ThaumicTinkererFabric"
