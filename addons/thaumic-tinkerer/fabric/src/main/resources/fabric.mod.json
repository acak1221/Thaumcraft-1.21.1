    "client": [
      "thaumic.tinkerer.fabric.ThaumicTinkererFabricClient"
    ],
    "thaumcraft": [
      "thaumic.tinkerer.fabric.ThaumicTinkererFabric"
    ]
  },
  "mixins": [
    "thaumictinkerer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
