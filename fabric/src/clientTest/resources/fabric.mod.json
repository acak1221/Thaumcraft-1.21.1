{
  "schemaVersion": 1,
  "id": "thaumcraft_client_smoke",
  "version": "1.0.0",
  "name": "Thaumcraft isolated client smoke harness",
  "environment": "client",
  "mixins": [
    "thaumcraft-client-smoke.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "thaumcraft.fabric.clienttest.BookClientSmoke",
      "thaumcraft.fabric.clienttest.MultiplayerClientProbe",
      "thaumcraft.fabric.clienttest.MultiplayerPeerProbe",
      "thaumcraft.fabric.testing.RecipeTransferClientProbe",
      "thaumcraft.fabric.testing.WandCrucibleClientProbe",
      "thaumcraft.fabric.testing.DeepslateOreClientProbe",
      "thaumcraft.fabric.testing.ModernAdaptationsClientProbe",
      "thaumcraft.fabric.testing.EmiIdentityReviewClientEntrypoint",
      "thaumcraft.fabric.testing.RendererReviewClientProbe",
      "thaumcraft.fabric.testing.MatrixCrystalClientProbe",
      "thaumcraft.fabric.testing.AspectSourcesClientEntrypoint"
    ],
    "jei_mod_plugin": ["thaumcraft.compat.jei.AspectSourcesClientProbe$JeiCapture"]
  },
  "depends": {
    "thaumcraft": "*",
    "fabricloader": ">=0.16.14",
    "architectury": ">=13.0.11",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
