{
  "schemaVersion": 1,
  "id": "thaumcraft_gametest",
  "version": "1.0.0",
  "name": "Thaumcraft isolated GameTest harness",
  "environment": "server",
  "mixins": [
    "thaumcraft-bore-gametest.mixins.json",
    "thaumcraft-gametest-selection.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "thaumcraft.fabric.testing.ThaumcraftGameTestBootstrap"
    ],
    "fabric-gametest": [
      "thaumcraft.fabric.testing.ThaumcraftGameTests",
      "thaumcraft.fabric.testing.RecipeTransferGameTests",
      "thaumcraft.fabric.testing.WandVisualGameTests",
      "thaumcraft.fabric.testing.DeepslateOreGameTests",
      "thaumcraft.fabric.testing.ModernAdaptationsGameTests",
      "thaumcraft.fabric.testing.ComprehensiveReviewGameTests",
      "thaumcraft.fabric.testing.TailReviewGameTests",
      "thaumcraft.fabric.testing.InventoryScanGameTests"
    ]
  },
  "depends": {
    "thaumcraft": "*",
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
