{
  "schemaVersion": 1,
  "id": "thaumcraft",
  "version": "${version}",
  "name": "Thaumcraft 4.2 FOREVA",
  "description": "Unofficial port of Thaumcraft 4.2.3.5 (Minecraft 1.7.10) to Minecraft 1.21.1.",
  "authors": [
    "Azanor (original Thaumcraft)",
    "FOREVA contributors"
  ],
  "contact": {
    "homepage": "https://github.com/acak1221/Thaumcraft-1.21.1",
    "sources": "https://github.com/acak1221/Thaumcraft-1.21.1",
    "issues": "https://github.com/acak1221/Thaumcraft-1.21.1/issues"
  },
  "environment": "*",
  "icon": "assets/thaumcraft/icon.png",
  "accessWidener": "thaumcraft.accesswidener",
  "entrypoints": {
    "main": [
      "thaumcraft.fabric.ThaumcraftFabric"
    ],
    "client": [
      "thaumcraft.fabric.ThaumcraftFabricClient"
    ],
    "emi": [
      "thaumcraft.fabric.compat.emi.ThaumcraftEmiPlugin"
    ],
    "modmenu": [
      "thaumcraft.fabric.compat.ThaumcraftModMenu"
    ]
  },
  "mixins": [
    "thaumcraft-common.mixins.json",
    "thaumcraft-fabric-compat.mixins.json",
    "thaumcraft-fabric-client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.11",
    "fabric-api": "*"
  },
  "license": "See THIRD_PARTY_NOTICES.md",
  "suggests": {
    "emi": "*",
    "modmenu": "*"
  }
}
